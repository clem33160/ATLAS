#!/usr/bin/env bash
set -euo pipefail
cmd="${1:-}"; shift || true
case "$cmd" in
  index) echo "index hook" ;;
  search) echo "search hook" ;;
  deliver) echo "deliver hook" ;;
  import-gmail) echo "import-gmail hook" ;;
  proof1000) python - <<'PY'
from core.proof.proof1000 import run_proof1000
from pathlib import Path
print(run_proof1000(Path('/tmp/proof1000')).CRITICAL_FAIL)
PY
    ;;
  global-scale) python - "$@" <<'PY'
from core.global_scale.report import global_scale_report
import sys
args=sys.argv[1:]
entities=0
persons=0
if '--entities' in args:
    entities=int(args[args.index('--entities')+1])
if '--persons' in args:
    persons=int(args[args.index('--persons')+1])
if entities==0 and persons==0:
    entities=2_000_000_000
print(global_scale_report(target_entities=entities,target_persons=persons))
PY
    ;;
  proof-global-scale) python - <<'PY'
from pathlib import Path
from core.proof.proof_global_scale import run_proof_global_scale
res=run_proof_global_scale(Path('~/atlas_data/sandbox/global_scale').expanduser())
print('ATLAS PROOF GLOBAL SCALE')
print('CRITICAL_FAIL:',res.CRITICAL_FAIL)
print('Decision:','PROOF_GLOBAL_SCALE_PASS' if res.CRITICAL_FAIL==0 else 'PROOF_GLOBAL_SCALE_FAIL')
PY
    ;;
  proof100-clients) python - <<'PY'
from core.proof.proof100_clients import format_proof100_clients_report, run_proof100_clients
print(format_proof100_clients_report(run_proof100_clients('~/atlas_data/sandbox/proof100_clients')))
PY
    ;;
  proof10000-clients) python - <<'PY'
from core.proof.proof10000_clients import format_proof10000_clients_report, run_proof10000_clients
print(format_proof10000_clients_report(run_proof10000_clients('~/atlas_data/sandbox/proof10000_clients')))
PY
    ;;
  proof100000-clients) python - <<'PY'
from core.proof.proof100000_clients import format_proof100000_clients_report, run_proof100000_clients
print(format_proof100000_clients_report(run_proof100000_clients('~/atlas_data/sandbox/proof100000_clients')))
PY
    ;;
  readiness) python - <<'PY'
from core.cli_reports import readiness_report
print(readiness_report(), end='')
PY
    ;;
  value-report) python - <<'PY'
from core.cli_reports import value_report
print(value_report(), end='')
PY
    ;;
  tenant-create) python - <<'PY'
from core.tenancy.tenant import Tenant
print(Tenant.create(tenant_id='demo',tenant_name='Demo',legal_entity_name='Demo LLC',country='FR',region='EU',plan='pilot_local',status='active',data_region='eu',isolation_mode='local_single_tenant',billing_account_id='ba',admin_user_id='admin').tenant_id)
PY
    ;;
  tenant-proof|proof-saas) python - <<'PY'
from pathlib import Path
from core.proof.proof_saas import run_proof_saas
print(run_proof_saas(Path('/tmp/proof_saas')))
PY
    ;;
  saas-readiness) python - <<'PY'
from core.readiness.scoring import readiness_score
print(readiness_score({'pilot_ready':True,'Multi-tenant isolation':8,'Tenant-aware RBAC':8,'Scale architecture':5}))
PY
    ;;
  usage-report) python - <<'PY'
from core.billing.invoices import usage_report
print(usage_report('demo','artisan_basic',{'documents_imported':123}))
PY
    ;;
  backup-check) python - <<'PY'
from core.backup.snapshot import build_snapshot_manifest
from core.backup.restore_check import simulate_restore
print(simulate_restore(build_snapshot_manifest('demo',['doc1'])))
PY
    ;;
  privacy-export) python - <<'PY'
from core.privacy.export_request import new_export_request
print(new_export_request('demo','admin'))
PY
    ;;
  dashboard) python apps/local_dashboard/server.py ;;
  *) echo "usage: atlas {index|search|deliver|import-gmail|proof1000|proof100-clients|proof10000-clients|proof100000-clients|readiness|value-report|dashboard|tenant-create|tenant-proof|saas-readiness|usage-report|backup-check|privacy-export|proof-saas|global-scale|proof-global-scale}"; exit 1 ;;
esac
